{
  "name": "copy-tab-info",
  "displayName": "Copy Tab Info",
  "version": "1.1.0",
  "description": "Copy current Tab title and url",
  "author": "Deer404",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "plasmo": "0.88.0",
    "punycode": "^2.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.19.35",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.6",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "activeTab",
      "clipboardWrite",
      "commands",
      "scripting",
      "storage"
    ],
    "commands": {
      "copy-tab-info": {
        "suggested_key": {
          "default": "Ctrl+Shift+P",
          "mac": "Command+Shift+P"
        },
        "description": "Copy Tab Information"
      },
      "copy-tab-info-markdown": {
        "suggested_key": {
          "default": "Ctrl+Shift+M",
          "mac": "Command+Shift+M"
        },
        "description": "Copy Tab Information as Markdown"
      },
      "copy-tab-info-custom": {
        "description": "Copy custom tab info"
      }
    }
  },
  "volta": {
    "node": "20.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
